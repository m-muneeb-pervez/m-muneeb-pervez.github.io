# Umami website ID (a UUID from your Umami dashboard: Settings, Websites, Edit).
# This value is public (it ends up in the built JS), so .env.production can be committed.
# Copy this file to .env.production and fill it in. Leave empty to disable analytics.
VITE_UMAMI_WEBSITE_ID=

# Optional: the script URL of a self-hosted Umami. Defaults to Umami Cloud.
# VITE_UMAMI_SRC=https://analytics.example.com/script.js
